# =============================================================================
# HIVER AI SUPPORT AGENT — ENVIRONMENT VARIABLES
# Full Setup Guide below each variable
# =============================================================================

# -----------------------------------------------------------------------------
# 1. GROQ API KEY (PRIMARY LLM) — FREE, NO CREDIT CARD
# -----------------------------------------------------------------------------
# What it does: Powers the AI reply drafting, intent classification, and
#               LLM-as-judge evaluation. Uses Llama 3.1 70B model.
#
# How to get it (2 minutes):
#   Step 1: Go to https://console.groq.com
#   Step 2: Click "Sign In" → use Google account (no credit card needed)
#   Step 3: In dashboard, click "API Keys" in left sidebar
#   Step 4: Click "Create API Key" → give it a name like "hiver-agent"
#   Step 5: Copy the key (starts with "gsk_") and paste below
#
# Free tier limits: 14,400 requests/day, 500K tokens/min — more than enough
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here


# -----------------------------------------------------------------------------
# 2. KAGGLE CREDENTIALS — FREE, JUST NEEDS KAGGLE ACCOUNT
# -----------------------------------------------------------------------------
# What it does: Downloads the Twitter Customer Support dataset (~3M tweets, ~500MB)
#               Dataset: https://www.kaggle.com/datasets/thoughtvector/customer-support-on-twitter
#
# How to get it (3 minutes):
#   Step 1: Go to https://www.kaggle.com and create a free account (or log in)
#   Step 2: Click your profile picture (top right) → "Settings"
#   Step 3: Scroll down to "API" section
#   Step 4: Click "Create New Token" — this downloads a file called kaggle.json
#   Step 5: Open that file, it looks like:
#           {"username":"yourusername","key":"your32charkey"}
#   Step 6: Copy the values into the fields below
#
# Free tier limits: Unlimited downloads — no restrictions
# -----------------------------------------------------------------------------
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key_here


# -----------------------------------------------------------------------------
# 3. QDRANT CLOUD (VECTOR DATABASE) — FREE, NO CREDIT CARD
# -----------------------------------------------------------------------------
# What it does: Stores vector embeddings of historical tweet resolutions.
#               Used for RAG (Retrieval-Augmented Generation) to find
#               similar past cases when drafting replies.
#
# How to get it (5 minutes):
#   Step 1: Go to https://cloud.qdrant.io
#   Step 2: Click "Sign Up" → use Google account (no credit card needed)
#   Step 3: Click "Create Cluster" → select "Free tier" (1GB, forever free)
#   Step 4: Choose any cloud provider & region (e.g., AWS us-east-1)
#   Step 5: Name it "hiver-support" → click Create
#   Step 6: Once cluster is ready (1-2 min), go to cluster → "API Keys"
#   Step 7: Create an API key, copy it below
#   Step 8: Copy the cluster URL (looks like: https://xxxx.us-east-1-0.aws.cloud.qdrant.io)
#
# Free tier limits: 1GB storage, 1 cluster — enough for ~1M vectors
# -----------------------------------------------------------------------------
QDRANT_URL=https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=hiver_support_tweets


# -----------------------------------------------------------------------------
# 4. HUGGING FACE TOKEN — FREE, OPTIONAL
# -----------------------------------------------------------------------------
# What it does: Downloads SetFit models for few-shot intent classification.
#               Most models work WITHOUT this token. Only needed if you hit
#               a gated model (will get an error message telling you).
#
# How to get it (2 minutes):
#   Step 1: Go to https://huggingface.co and create a free account
#   Step 2: Click your profile picture → "Settings" → "Access Tokens"
#   Step 3: Click "New token" → name it "hiver-agent" → select "Read" access
#   Step 4: Click "Generate a token" → copy it below (starts with "hf_")
#
# Free tier limits: Unlimited for public models
# -----------------------------------------------------------------------------
HF_TOKEN=hf_your_huggingface_token_here


# -----------------------------------------------------------------------------
# 5. MISTRAL API KEY — FREE BACKUP LLM (OPTIONAL)
# -----------------------------------------------------------------------------
# What it does: Fallback LLM if Groq rate limits are hit.
#               Mistral Small is free tier.
#
# How to get it (3 minutes):
#   Step 1: Go to https://console.mistral.ai
#   Step 2: Sign up with Google/email (no credit card for free tier)
#   Step 3: Go to "API Keys" → "Create new key"
#   Step 4: Copy key below
#
# Free tier limits: 1B tokens/month on free tier
# -----------------------------------------------------------------------------
MISTRAL_API_KEY=your_mistral_api_key_here


# =============================================================================
# APP CONFIGURATION — NO EXTERNAL SERVICE NEEDED, JUST EDIT THESE
# =============================================================================

# The brand from the Kaggle dataset we are building the agent for
# Options from dataset: AppleSupport, AmazonHelp, Spotify, Delta, etc.
TARGET_BRAND=AppleSupport

# LLM model to use via Groq
# Options: llama-3.1-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.1-70b-versatile

# Embedding model (runs locally, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Number of similar past cases to retrieve for RAG
RAG_TOP_K=5

# Confidence threshold below which messages are escalated to human
ESCALATION_CONFIDENCE_THRESHOLD=0.65

# Environment: development or production
ENVIRONMENT=development

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Data paths (relative to project root)
DATA_RAW_PATH=data/raw
DATA_PROCESSED_PATH=data/processed
GOLDEN_EVAL_PATH=data/golden_eval

# SQLite database path (local file, no server needed)
SQLITE_DB_PATH=data/hiver_agent.db
