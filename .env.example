GROQ_API_KEY=gsk_your_groq_api_key_here


KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key_here

QDRANT_URL=https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=hiver_support_tweets


TARGET_BRAND=AppleSupport
GROQ_MODEL=llama-3.1-70b-versatile
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5
ESCALATION_CONFIDENCE_THRESHOLD=0.65
ENVIRONMENT=development
LOG_LEVEL=INFO
DATA_RAW_PATH=data/raw
DATA_PROCESSED_PATH=data/processed
GOLDEN_EVAL_PATH=data/golden_eval
SQLITE_DB_PATH=data/hiver_agent.db
